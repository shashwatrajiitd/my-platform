{
  "name": "@portfolio/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs'); const bad=fs.existsSync('.next') && !fs.existsSync('.next/server/middleware-manifest.json'); if(bad){console.log('[predev] Detected stale .next (missing middleware-manifest). Cleaning...'); fs.rmSync('.next',{recursive:true,force:true}); }\"",
    "dev": "next dev",
    "dev:turbo": "TURBOPACK=1 next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@portfolio/types": "file:../../packages/types",
    "@portfolio/ui": "file:../../packages/ui",
    "@portfolio/utils": "file:../../packages/utils",
    "monaco-editor": "^0.45.0",
    "next": "^14.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
